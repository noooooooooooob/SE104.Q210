<Window x:Class="Sprint8_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lập bảng thống kê tình hình mượn Game theo thể loại"
        Height="560" Width="780"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Border BorderBrush="Black" BorderThickness="1" CornerRadius="8" Margin="10" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="65"/>
            </Grid.RowDefinitions>

            <!-- Tiêu đề + X -->
            <Grid Grid.Row="0">
                <TextBlock Text="Lập bảng thống kê tình hình mượn Game theo thể loại"
                           FontSize="18" FontWeight="Bold" Margin="20,12,0,12"
                           TextWrapping="Wrap"/>
                <Button Content="X" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,12,0" Width="30" Height="30" FontSize="14"
                        Background="Transparent" BorderThickness="0"
                        Click="BtnThoat_Click"/>
            </Grid>

            <Border Grid.Row="1" BorderBrush="#AAAAAA" BorderThickness="0,1,0,0"/>

            <!-- Nội dung -->
            <Border Grid.Row="2" Margin="12,12,12,12" Padding="14"
                    BorderBrush="#CCCCCC" BorderThickness="1"
                    CornerRadius="5" Background="#EEF1F5">
                <StackPanel>

                    <!-- HÀNG 1: Tháng thống kê | Năm thống kê -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tháng thống kê -->
                        <StackPanel Grid.Column="0">
                            <Label Content="Tháng thống kê" FontSize="13" Padding="0,0,0,2"/>
                            <Border BorderBrush="#AAAAAA" BorderThickness="1" CornerRadius="4"
                                    Height="36" Background="White">
                                <TextBox x:Name="txtThang" FontSize="13" BorderThickness="0"
                                         VerticalContentAlignment="Center" Margin="8,0"
                                         Text=""/>
                            </Border>
                        </StackPanel>

                        <!-- Năm thống kê -->
                        <StackPanel Grid.Column="2">
                            <Label Content="Năm thống kê" FontSize="13" Padding="0,0,0,2"/>
                            <Border BorderBrush="#AAAAAA" BorderThickness="1" CornerRadius="4"
                                    Height="36" Background="White">
                                <TextBox x:Name="txtNam" FontSize="13" BorderThickness="0"
                                         VerticalContentAlignment="Center" Margin="8,0"
                                         Text=""/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Tổng số lượt mượn -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Tổng số lượt mượn trong tháng của tất cả loại game: "
                                   FontSize="13" VerticalAlignment="Center"/>
                        <Border BorderBrush="#AAAAAA" BorderThickness="1" CornerRadius="4"
                                MinWidth="120" Height="30" Background="#E0E0E0">
                            <TextBlock x:Name="txbTongSoLuot" FontSize="13"
                                       VerticalAlignment="Center" Margin="8,0"
                                       FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <!-- BẢNG KẾT QUẢ -->
                    <Border BorderBrush="#AAAAAA" BorderThickness="1" CornerRadius="4"
                            Background="White" Height="300">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Grid Grid.Row="0" Background="#D0D0D0" Height="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="STT"
                                           FontWeight="Bold" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="TÊN LOẠI GAME"
                                           FontWeight="Bold" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="SỐ LƯỢT MƯỢN TRONG THÁNG"
                                           FontWeight="Bold" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="4,0"/>
                                <TextBlock Grid.Column="3" Text="TỈ LỆ"
                                           FontWeight="Bold" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Dữ liệu (scroll) -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="icKetQua">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="38">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="190"/>
                                                    <ColumnDefinition Width="100"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                                                    <TextBlock Text="{Binding STT}" FontSize="13"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Border Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                                                    <TextBlock Text="{Binding TenLoaiGame}" FontSize="13"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Margin="6,0"/>
                                                </Border>
                                                <Border Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="0,0,1,1">
                                                    <TextBlock Text="{Binding SoLuotMuon}" FontSize="13"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Border Grid.Column="3" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                                    <TextBlock Text="{Binding TiLe}" FontSize="13"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                </StackPanel>
            </Border>

            <Border Grid.Row="3" BorderBrush="#AAAAAA" BorderThickness="0,1,0,0"/>

            <!-- Nút bấm -->
            <Grid Grid.Row="4" Margin="12,12,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Lập bảng thống kê"
                        Height="42" Width="200" FontSize="15"
                        Background="#00BCD4" Foreground="White" BorderThickness="0"
                        Click="BtnLapBangThongKe_Click"/>

                <Button Grid.Column="2" Content="Thoát"
                        Height="42" Width="100" FontSize="15"
                        Background="#00BCD4" Foreground="White" BorderThickness="0"
                        Click="BtnThoat_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
